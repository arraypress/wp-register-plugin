{
  "name": "arraypress/wp-register-plugin",
  "description": "A universal WordPress plugin registration system with flexible requirements checking and conflict detection. Simplifies plugin development with smart defaults for EDD, WooCommerce, Elementor, and custom ecosystems.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-register-plugin/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterPlugin\\": "src/"
    },
    "files": [
      "src/Functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-plugin/issues",
    "source": "https://github.com/arraypress/wp-register-plugin"
  },
  "keywords": [
    "wordpress",
    "wp-plugin",
    "plugin-registration",
    "requirements-checker",
    "conflict-detection",
    "edd",
    "easy-digital-downloads",
    "woocommerce",
    "elementor",
    "plugin-framework",
    "plugin-loader",
    "dependency-management",
    "version-checking",
    "plugin-bootstrap",
    "wordpress-development",
    "plugin-development",
    "auto-deactivate",
    "plugin-conflicts",
    "php-version-check",
    "wordpress-version-check",
    "plugin-ecosystem",
    "extension-development",
    "addon-development",
    "pro-plugin",
    "free-plugin-conflict"
  ],
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\RegisterPlugin\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php -d auto_prepend_file=tests/constants.php vendor/bin/phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
