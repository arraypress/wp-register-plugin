<?xml version="1.0"?>
<ruleset name="wp-register-plugin">
    <description>
        The WordPress sniffs worth enforcing here.

        Deliberately not the full WordPress standard: most of what that adds is
        formatting this codebase consistently does differently, short array
        syntax above all. A wall of noise nobody reads is how a real finding
        gets lost. What is left is the part that catches defects rather than
        preferences.
    </description>

    <file>src</file>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Register the standards from the ruleset rather than relying on
         phpcodesniffer-composer-installer. That plugin registers them by
         running phpcs, and phpcs loads this package's autoloader, which opens
         src/Functions.php and exits on the ABSPATH guard, so the
         registration silently never happened and every sniff below resolved
         to nothing. -->
    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcompatibility/php-compatibility,vendor/phpcompatibility/phpcompatibility-paragonie,vendor/phpcompatibility/phpcompatibility-wp,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra"/>


    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n"/>
    <!-- Every translatable string in this package uses this domain. -->
    <config name="text_domain" value="arraypress"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.2-"/>
</ruleset>
